# Build artifacts + deps are produced inside the image, never copied in.
**/node_modules
dist
frontend/.next
frontend/out
packages/*/dist
# Build-staged frontend embed (go:embed); the image rebuilds it fresh in the
# backend stage, so never copy a stale local copy into the build context.
backend/internal/webui/public
.data
.git
.github
*.log
npm-debug.log*
.DS_Store
# Docker meta-files are not consumed by any build's COPY (the Dockerfile is read
# by the builder directly), so keep them out of the context. NB: do NOT ignore the
# `docker/` dir - Dockerfile.dev copies docker/entrypoint-dev.sh from it.
Dockerfile*
docker-compose*.yml

# Never bake local secrets into the image; env is provided at run time.
.env
.env.*
!.env.example
