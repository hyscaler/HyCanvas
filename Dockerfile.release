# Lean release image: packages a prebuilt hycanvas release binary instead of
# compiling the stack, so multi-arch publishes take minutes, not QEMU-compiled
# toolchain runs. The release pipeline extracts the per-arch linux binaries
# into binaries/<arch>/hycanvas before building; the runtime layers mirror
# Dockerfile's runtime stage exactly.
#
#   docker buildx build -f Dockerfile.release --platform linux/amd64,linux/arm64 .

FROM debian:bookworm-slim
WORKDIR /app

# ffmpeg: video export. ca-certificates: outbound TLS (AI providers, SSO).
# curl: container healthcheck against /healthz.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# Runs as an unprivileged user, never root. The uid is numeric so Kubernetes
# runAsNonRoot can verify it. /app (the working directory, where the setup
# wizard writes .env) and the storage directory are owned by group 0 with group
# write, so the default user, a new named volume (which copies this ownership)
# and any uid run in group 0 (runAsUser, OpenShift) can all write them. The
# binary lives in root-owned /usr/local/bin, out of reach of the process.
# A storage volume created by an earlier image is root-owned; the server
# refuses to start on it with the one-time chown that fixes it (DOCKER_SETUP.md).
RUN useradd --uid 10001 --gid 0 --home-dir /app --no-create-home --shell /usr/sbin/nologin hycanvas \
 && mkdir -p /app/.data/storage \
 && chown -R 10001:0 /app \
 && chmod -R g=u /app

# TARGETARCH is set by buildx per platform (amd64 / arm64).
ARG TARGETARCH
COPY binaries/${TARGETARCH}/hycanvas /usr/local/bin/hycanvas
# The old path, for anything that still calls /app/hycanvas.
RUN ln -s /usr/local/bin/hycanvas /app/hycanvas
# The license and notices from the release archive (AGPL-3.0-only).
COPY binaries/${TARGETARCH}/LICENSE binaries/${TARGETARCH}/NOTICE binaries/${TARGETARCH}/COMMERCIAL.md binaries/${TARGETARCH}/TRADEMARKS.md /app/
LABEL org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="https://github.com/hyscaler/HyCanvas"

ENV HOME=/app \
    PORT=8005 \
    DB_AUTO_MIGRATE=true \
    STORAGE_DRIVER=local \
    LOCAL_STORAGE_PATH=/app/.data/storage

EXPOSE 8005
# Persist uploads/exports/snapshots when using the local storage driver.
VOLUME ["/app/.data/storage"]

# The Go binary serves /healthz once its HTTP listener is up.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -fsS "http://localhost:${PORT}/healthz" || exit 1

USER 10001:0
ENTRYPOINT ["/usr/local/bin/hycanvas"]
