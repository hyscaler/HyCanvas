  "voice": {
    "tone": ["confident", "plain-spoken", "warm", "specific"],
    "doSay": [
      "lead with what the reader can make",
      "say that everything is free, with no tiers, paywalls or watermarks",
      "mention self-hosting and bring-your-own AI keys where they matter",
      "keep sentences short and concrete"
    ],
    "dontSay": [
      "compare HyCanvas with other design tools",
      "use buzzwords such as seamless, unlock, supercharge or game-changing",
      "call anything enterprise-grade, best-in-class or world-class",
      "use long dashes"
    ],
    "sampleCopy": "Design anything, own everything. Brief in, beautiful deck out: tell HyCanvas what you need and it composes a finished, on-brand presentation you can edit, export and share. Free, open and self-hostable."
  }
