{
  "openapi": "3.1.0",
  "info": {
    "title": "HyCanvas Generation API",
    "version": "1.0.0",
    "description": "Programmatic deck generation and retrieval. Authenticate with a workspace API key (Authorization: Bearer hyk_...), minted by a workspace admin in Dashboard > Members > API keys. Keys are scoped (generate, read, export) and pinned to one workspace. Errors are RFC 7807 problem+json with a stable `code`. The same capabilities are exposed to AI agents over the Model Context Protocol at /mcp (streamable HTTP, same API keys/scopes/budgets)."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "hyk_..."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          }
        }
      },
      "GenerateRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "description": "The brief, e.g. 'a 6-slide pitch deck for an eco water bottle'."
          },
          "workspaceId": {
            "type": "string",
            "description": "Defaults to the API key's workspace; must match it when both are present."
          },
          "designType": {
            "type": "string",
            "enum": [
              "deck",
              "doc",
              "poster",
              "social"
            ],
            "default": "deck"
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "language": {
            "type": "string",
            "description": "Write all text in this language, e.g. 'Spanish'."
          },
          "brandPalette": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "maxItems": 12
          },
          "sources": {
            "type": "array",
            "maxItems": 8,
            "description": "Grounding material (untrusted reference text; instructions inside it are ignored).",
            "items": {
              "type": "object",
              "required": [
                "name",
                "text"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "themeId": {
            "type": "string",
            "description": "A built-in theme id (see GET /themes), e.g. 'theme-slate'; omit for an auto-picked look."
          },
          "brandKitId": {
            "type": "string",
            "description": "A brand kit id from this workspace: the deck takes that kit's palette, fonts, logo and voice instead of the workspace's default kit. An id from another workspace is ignored."
          },
          "templateId": {
            "type": "string",
            "description": "A template id: the deck is composed on that template's layout system and theme (workspace templates and public built-ins; see the MCP list_templates tool)."
          },
          "motion": {
            "type": "string",
            "enum": [
              "subtle",
              "none"
            ],
            "description": "Entrance motion on the composed slides: one quiet reveal per page in reading order (default), or none."
          }
        }
      },
      "GenerateAccepted": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "look": {
            "type": "string",
            "enum": [
              "classic",
              "editorial",
              "bold",
              "technical"
            ],
            "description": "The deck's house style: what the forms are made of (pairing, rules, corners, panels, the impact-page construction). Omit to let the model name one from the brief; a chosen theme's fonts and a brand kit's fonts keep their pairing either way."
          },
          "poll": {
            "type": "string",
            "description": "Path to poll for the result."
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "failed"
            ]
          },
          "result": {
            "description": "On completion of a generation job: { designId, title, pageCount, editorUrl, quality, images }. quality is the composer's verdict on the saved deck: { ok, stillLong (pages whose copy is still long after one shortening pass), bulletShare (share of pages set as plain bullets) }. images reports the picture regions: { requested, placed, reused, stock, generated, unsupported }; a region that could not be filled keeps its stand-in and can be filled in the editor, and unsupported is true when the workspace's provider cannot generate images at all.",
            "type": "object"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ApiKeyView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "generate",
                "read",
                "export"
              ]
            }
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/generate/presentation": {
      "post": {
        "summary": "Generate a presentation, document, poster, or social set from a prompt",
        "description": "Runs the full server-side pipeline (outline with per-page copy polish, deterministic layout composition, theme) and saves the result as a design in the workspace. Returns 202 with a job to poll. Scope: generate. Budget: ~3 generations/minute per key. The composed deck contains text, layout, theme, and speaker notes; per-slide images are generated in the editor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Generation started.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope or workspace mismatch.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Over the generation budget.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Poll a job",
        "description": "Any valid key can poll jobs the API itself started (generation, document export). A completed generation job's result carries designId and editorUrl.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job (or another user's).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/designs/{id}": {
      "get": {
        "summary": "Design record (title, timestamps)",
        "description": "Scope: read. The design must belong to the key's workspace.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The design record."
          }
        }
      }
    },
    "/designs/{id}/file": {
      "get": {
        "summary": "The design's open-format file (hycanvas.design JSON)",
        "description": "Scope: read. Fully editable open format; see the schema package for the format contract.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The design file JSON."
          }
        }
      }
    },
    "/designs/{id}/render.pdf": {
      "get": {
        "summary": "Render the design to PDF (server-side engine)",
        "description": "Scope: export.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF bytes.",
            "content": {
              "application/pdf": {}
            }
          }
        }
      }
    },
    "/designs/{id}/render.png": {
      "get": {
        "summary": "Render a page to PNG (server-side engine)",
        "description": "Scope: export.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNG bytes.",
            "content": {
              "image/png": {}
            }
          }
        }
      }
    },
    "/designs/{id}/links": {
      "post": {
        "summary": "Create a share link for the design",
        "description": "Scope: export. Body: { mode: view|comment|edit, password?, expiresAt?, requireSignin?, label? }. The returned token forms the share URL /shared/{token}/ (append ?embed=1 for the iframe player).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The share link (token included)."
          }
        }
      }
    },
    "/workspaces/{id}/api-keys": {
      "get": {
        "summary": "List the workspace's API keys",
        "description": "SESSION-ONLY (admin). API keys cannot manage API keys.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Keys, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiKeyView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Mint an API key",
        "description": "SESSION-ONLY (admin). The response's `key` is the raw secret, shown exactly once.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "label",
                  "scopes"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "generate",
                        "read",
                        "export"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "{ key, view }"
          }
        }
      }
    },
    "/workspaces/{id}/api-keys/{keyId}": {
      "delete": {
        "summary": "Revoke an API key",
        "description": "SESSION-ONLY (admin). Revocation is immediate and permanent.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked."
          }
        }
      }
    },
    "/workspaces/{id}/api-keys/audit": {
      "get": {
        "summary": "Recent API-key activity for the workspace",
        "description": "SESSION-ONLY (admin). One entry per meaningful key action (HTTP route or MCP tool; job polling excluded), newest first, retained for 90 days.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit entries: { id, keyId, workspaceId, userId, surface, designId, at }."
          }
        }
      }
    },
    "/themes": {
      "get": {
        "summary": "The built-in theme catalog",
        "description": "Any session or valid key. Entries carry id, name, style group, six palette slots [primary, accent, deep, tint, ink, paper], and the font pair; ids are valid generate themeIds.",
        "responses": {
          "200": {
            "description": "The theme catalog."
          }
        }
      }
    }
  }
}
